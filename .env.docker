APP_NAME=Compasso
APP_ENV=production
APP_KEY=base64:Jooa+G1Pnm9eKnq13mmj7LJBBD1efds9+MAPmXNJoZ4=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://api.institutoprimeirasnotas.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Banco de Dados ────────────────────────────────────────────────────────────
# DB_HOST deve ser "db" para funcionar no Docker (nome do serviço no docker-compose)
DB_CONNECTION=mysql
DB_HOST=compasso_db
DB_PORT=3306
DB_DATABASE=compasso
DB_USERNAME=compasso
DB_PASSWORD=Redo@147789.

# ─── Sessão e Cache ────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=compasso_

# ─── Redis (opcional) ─────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── E-mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@camerata.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Swagger ───────────────────────────────────────────────────────────────────
L5_SWAGGER_USE_ABSOLUTE_PATH=https://api.institutoprimeirasnotas.com.br
L5_SWAGGER_CONST_HOST=https://api.institutoprimeirasnotas.com.br
WHATSAPP_API_URL=http://whatsapp_app
